# Vercel deployment ignore file for frontend

# Development files
.env.example
.git/
.gitignore

# Test files
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Documentation
README.md

# Node modules (handled by package.json)
node_modules/

# Build artifacts (except dist which is needed)
.vite/
coverage/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# ESLint cache
.eslintcache

# TypeScript cache
*.tsbuildinfo
